---
import { resolveMusic, type Config } from '../config';
import ThemeToggle from './ThemeToggle.astro';
import type { LocaleMessages } from '../i18n/utils';
import { DEFAULT_MESSAGES } from '../i18n/utils';

interface Props {
  config: Config;
  messages?: LocaleMessages;
}

const { config, messages } = Astro.props;
const showShare = config.sections?.share !== false;
const showThemeToggle = config.sections?.themeToggle === true;
const showPhotoWall = config.sections?.photoWall !== false && !!config.photos?.length;
const music = resolveMusic(config);
const showMusic = music.enabled && music.tracks.length > 0;
const hasAny = showShare || showThemeToggle || showPhotoWall || showMusic;

const generateCardLabel = messages?.actions.generateCard || DEFAULT_MESSAGES.actions.generateCard;
const photoWallLabel = messages?.actions.openPhotoWall || DEFAULT_MESSAGES.actions.openPhotoWall;
const musicLabel = messages?.actions.playMusic || DEFAULT_MESSAGES.actions.playMusic;
const floatingActionsAriaLabel = messages?.floatingActions?.ariaLabel || DEFAULT_MESSAGES.floatingActions.ariaLabel;
---

{hasAny && (
  <div class="floating-actions" aria-label={floatingActionsAriaLabel}>
    {showShare && (
      <button class="share-btn float-action-btn float-action-btn-primary" id="shareBtn" type="button" title={generateCardLabel} aria-label={generateCardLabel}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
      </button>
    )}
    {showPhotoWall && (
      <button id="photoWallEntry" class="photo-wall-entry float-action-btn" type="button" aria-label={photoWallLabel} title={photoWallLabel}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 8.5A2.5 2.5 0 0 1 6.5 6H9l1.2-1.6A2 2 0 0 1 11.8 3.5h.4a2 2 0 0 1 1.6.9L15 6h2.5A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5z" />
          <circle cx="12" cy="12.5" r="3.2" />
        </svg>
      </button>
    )}
    {showMusic && (
      <button class="music-btn float-action-btn" id="musicBtn" type="button" aria-label={musicLabel} title={musicLabel}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
      </button>
    )}
    {showThemeToggle && <ThemeToggle defaultTheme={config.defaultTheme || 'dark'} messages={messages} />}
  </div>
)}
