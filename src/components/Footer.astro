---
import type { Config } from '../config';
import type { LocaleMessages } from '../i18n/utils';
import { DEFAULT_MESSAGES } from '../i18n/utils';

interface Props {
  config: Config;
  messages?: LocaleMessages;
}

const { config, messages } = Astro.props;
const startYear = config.loveDate.split('-')[0];
const defaultFooterLabels = DEFAULT_MESSAGES.footer;
const madeWithLove = messages?.footer?.madeWithLove || defaultFooterLabels.madeWithLove;
const viewOnGithub = messages?.footer?.viewOnGithub || defaultFooterLabels.viewOnGithub;
---

<footer class="footer-main text-center text-white/50 text-xs sm:text-sm tracking-wider select-none mt-4 flex flex-col items-center gap-3">
  <p>❤ {startYear} — {madeWithLove} ❤</p>
  <a href={config.repositoryUrl} target="_blank" rel="noopener noreferrer">LovePage · GitHub</a>
  <a
    href="https://github.com/funnyzak/love-page"
    target="_blank"
    rel="noopener noreferrer"
    class="transition-colors"
    aria-label={viewOnGithub}
    title={viewOnGithub}
  >基于 funnyzak/love-page</a>
</footer>
