---
import { resolveAnniversaries, type Config } from '../config';
import { APP_EVENTS } from '../constants/client';
import { DEFAULT_MESSAGES, type LocaleMessages } from '../i18n/utils';

interface Props {
  config: Config;
  messages?: LocaleMessages;
}

const { config, messages } = Astro.props;
const m = messages ?? DEFAULT_MESSAGES;
const anniversaries = resolveAnniversaries(config);
const sectionTitle = m.sections.todaySummary;
const defaultPrimary = m.todaySummary.defaultPrimary;
const defaultSecondary = m.todaySummary.defaultSecondary;
const ctaText = m.actions.generateCard;

const payload = {
  anniversaries,
  countdownThreshold: config.anniversaryCountdownThreshold ?? 10,
  generateMemorialCardEvent: APP_EVENTS.generateMemorialCard,
  messages: {
    defaultPrimary,
    defaultSecondary,
    todayPrimary: m.todaySummary.todayPrimary,
    todaySecondary: m.todaySummary.todaySecondary,
    soonPrimary: m.todaySummary.soonPrimary,
    soonSecondary: m.todaySummary.soonSecondary,
    upcomingPrimary: m.todaySummary.upcomingPrimary,
    upcomingSecondary: m.todaySummary.upcomingSecondary,
  },
};
---

<section class="w-full max-w-xl sm:max-w-2xl lg:max-w-3xl px-2 reveal" id="todaySummarySection">
  <h2 class="section-title">{sectionTitle}</h2>
  <div class="today-summary-card glass">
    <p class="today-summary-primary" id="todaySummaryPrimary">{defaultPrimary}</p>
    <p class="today-summary-secondary" id="todaySummarySecondary">{defaultSecondary}</p>
    <button class="today-summary-cta" id="todaySummaryShareBtn" type="button">{ctaText}</button>
  </div>
</section>

<script id="today-summary-script-payload" type="application/json" set:html={JSON.stringify(payload)}></script>
<script>
  import { formatDisplayLabel, getAnniversaryInfo } from '../scripts/anniversary/logic.ts';
  import { APP_EVENTS } from '../constants/client';
  import { readJsonPayload } from '../utils';

  (function initTodaySummary() {
    const primaryEl = document.getElementById('todaySummaryPrimary');
    const secondaryEl = document.getElementById('todaySummarySecondary');
    const shareTrigger = document.getElementById('todaySummaryShareBtn');
    if (!(primaryEl instanceof HTMLElement) || !(secondaryEl instanceof HTMLElement)) return;

    const payload = readJsonPayload('today-summary-script-payload', {
      anniversaries: [],
      countdownThreshold: 10,
      generateMemorialCardEvent: APP_EVENTS.generateMemorialCard,
      messages: {} as Record<string, string>,
    });
    const msg = payload.messages;
    const countdownThreshold = payload.countdownThreshold;
    let nearestAnniversaryIndex = null;

    function renderSummary() {
      const items = payload.anniversaries
        .filter((item) => typeof item?.date === 'string' && typeof item?.label === 'string')
        .map((item, originalIndex) => ({
          ...item,
          originalIndex,
          ...getAnniversaryInfo(item.date, item.label),
        }))
        .sort((a, b) => {
          if (a.gap !== b.gap) return a.gap - b.gap;
          return a.originalIndex - b.originalIndex;
        });

      if (!items.length) {
        nearestAnniversaryIndex = null;
        primaryEl.textContent = msg.defaultPrimary;
        secondaryEl.textContent = msg.defaultSecondary;
        return;
      }

      const nearest = items[0];
      nearestAnniversaryIndex = nearest.originalIndex;
      const displayLabel = formatDisplayLabel(nearest.label, nearest.nth);

      if (nearest.gap === 0) {
        primaryEl.textContent = msg.todayPrimary.replace('{displayLabel}', displayLabel);
        secondaryEl.textContent = msg.todaySecondary;
        return;
      }

      if (countdownThreshold > 0 && nearest.gap <= countdownThreshold) {
        primaryEl.textContent = msg.soonPrimary.replace('{displayLabel}', displayLabel).replace('{gap}', String(nearest.gap));
        secondaryEl.textContent = msg.soonSecondary;
        return;
      }

      primaryEl.textContent = msg.upcomingPrimary.replace('{displayLabel}', displayLabel);
      secondaryEl.textContent = msg.upcomingSecondary.replace('{gap}', String(nearest.gap));
    }

    renderSummary();

    if (shareTrigger instanceof HTMLButtonElement) {
      shareTrigger.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent(payload.generateMemorialCardEvent, {
            detail: {
              source: 'today-summary',
              anniversaryIndex: nearestAnniversaryIndex,
            },
          }),
        );
      });
    }
  })();
</script>
