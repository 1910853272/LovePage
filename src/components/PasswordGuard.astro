---
import { type PasswordConfig } from '../config';
import { hasPasswordGuard } from '../passwordGuardState';
import type { LocaleMessages } from '../i18n/utils';

interface Props {
  config?: PasswordConfig;
  messages?: LocaleMessages;
}

const { config, messages } = Astro.props;

if (!hasPasswordGuard(config)) {
  Astro.slots.render('default');
  return null;
}

const hintText = config.hint || messages?.password.hint || '请输入密码访问';
const placeholderText = messages?.password.placeholder || '请输入密码';
const errorText = config.errorMessage || messages?.password.error || '密码错误，请重试';
const rateLimitText = messages?.password.rateLimitMessage || '尝试过于频繁，请在 {seconds} 秒后重试';
const submitText = messages?.password.submit || '进入';
const titleText = messages?.password.title || '私密空间';
---

<div
  id="passwordGuard"
  class="password-guard-overlay glass-heavy"
  data-password={config.password || ''}
  data-success-message={config.successMessage || messages?.password.success || '欢迎进入 ❤️'}
  data-rate-limit-message={rateLimitText}
  data-rate-limit-enabled={config.bruteForceProtection?.enabled === false ? 'false' : 'true'}
  data-rate-limit-free-attempts={String(config.bruteForceProtection?.freeAttempts ?? 5)}
  data-rate-limit-base-lock-seconds={String(config.bruteForceProtection?.baseLockSeconds ?? 3)}
  data-rate-limit-max-lock-seconds={String(config.bruteForceProtection?.maxLockSeconds ?? 120)}
  data-rate-limit-failure-reset-minutes={String(config.bruteForceProtection?.failureResetMinutes ?? 30)}
>
  <div class="password-card glass reveal-scale">
    <div class="password-header">
      <div class="password-icon">🔒</div>
      <h2>{titleText}</h2>
      <p class="password-hint">{hintText}</p>
    </div>

    <div class="password-body">
      <div class="input-wrapper">
        <input
          type="password"
          id="passwordInput"
          placeholder={placeholderText}
          autocomplete="current-password"
        />
        <div class="input-line"></div>
      </div>
      <button id="unlockBtn" class="unlock-btn">
        <span>{submitText}</span>
        <div class="btn-glow"></div>
      </button>
    </div>

    <div id="passwordError" class="password-error">
      {errorText}
    </div>
  </div>
</div>

<style>
  .password-guard-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10000; /* Above loader (9999) */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
    backdrop-filter: blur(20px) saturate(180%);
    background: rgba(15, 15, 15, 0.4);
  }

  .password-guard-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  .password-card {
    width: 100%;
    max-width: 360px;
    padding: 40px 30px;
    border-radius: 24px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .password-icon {
    font-size: 40px;
    margin-bottom: 15px;
    filter: drop-shadow(0 0 10px rgba(255, 105, 180, 0.5));
  }

  h2 {
    font-size: 1.5rem;
    color: white;
    margin-bottom: 8px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .password-hint {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 30px;
  }

  .input-wrapper {
    position: relative;
    margin-bottom: 25px;
  }

  input {
    width: 100%;
    background: transparent;
    border: none;
    padding: 12px 5px;
    color: white;
    font-size: 1.1rem;
    text-align: center;
    outline: none;
    letter-spacing: 4px;
  }

  .input-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    transition: background 0.3s ease;
  }

  input:focus + .input-line {
    background: var(--pink, #ff69b4);
    box-shadow: 0 0 8px var(--pink, #ff69b4);
  }

  input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .unlock-btn {
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    border: none;
    background: var(--pink, #ff69b4);
    color: white;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .unlock-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 105, 180, 0.4);
  }

  .unlock-btn:active {
    transform: translateY(0);
  }

  .unlock-btn:disabled {
    cursor: not-allowed;
    opacity: 0.65;
    transform: none;
    box-shadow: none;
  }

  .unlock-btn:disabled .btn-glow {
    display: none;
  }

  .btn-glow {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    transition: left 0.5s ease;
  }

  .unlock-btn:hover .btn-glow {
    left: 100%;
  }

  .password-error {
    margin-top: 15px;
    color: #ff4d4d;
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .password-error.show {
    opacity: 1;
  }

  /* 震动动画 */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
  }

  .shake {
    animation: shake 0.3s ease-in-out;
  }
</style>

<script>
  import { APP_EVENTS, STORAGE_KEYS } from '../constants/client';
  import { encryptPassword } from '../passwordCipher';
  import {
    computeLockMs,
    createDefaultRateState,
    normalizeRateState,
    parseNumberInRange,
    sanitizeRateState,
  } from '../scripts/passwordGuard/rateLimit.ts';

  (function initPasswordGuard() {
    const STORAGE_KEY = STORAGE_KEYS.unlocked;
    const RATE_LIMIT_KEY = STORAGE_KEYS.passwordRateLimit;
    const store = window.__LOVE_STORE__;
    const DEFAULT_FREE_ATTEMPTS = 5;
    const DEFAULT_BASE_LOCK_SECONDS = 3;
    const DEFAULT_MAX_LOCK_SECONDS = 120;
    const DEFAULT_FAILURE_RESET_MINUTES = 30;
    const guard = document.getElementById('passwordGuard');
    if (!guard) return;
    const LOCK_ERROR_TEMPLATE = guard.dataset.rateLimitMessage || '尝试过于频繁，请在 {seconds} 秒后重试';

    const input = document.getElementById('passwordInput');
    const btn = document.getElementById('unlockBtn');
    const error = document.getElementById('passwordError');
    const card = guard.querySelector('.password-card');
    if (!(input instanceof HTMLInputElement)) return;
    if (!(btn instanceof HTMLButtonElement)) return;
    if (!(error instanceof HTMLElement)) return;
    if (!(card instanceof HTMLElement)) return;

    const expectedPassword = guard.dataset.password || '';
    const successMessage = guard.dataset.successMessage || '欢迎进入 ❤️';
    const rateLimitEnabled = guard.dataset.rateLimitEnabled !== 'false';
    const freeAttempts = parseNumberInRange(
      guard.dataset.rateLimitFreeAttempts,
      DEFAULT_FREE_ATTEMPTS,
      0,
      50,
    );
    const baseLockSeconds = parseNumberInRange(
      guard.dataset.rateLimitBaseLockSeconds,
      DEFAULT_BASE_LOCK_SECONDS,
      1,
      600,
    );
    const maxLockSeconds = parseNumberInRange(
      guard.dataset.rateLimitMaxLockSeconds,
      DEFAULT_MAX_LOCK_SECONDS,
      1,
      24 * 60 * 60,
    );
    const failureResetMinutes = parseNumberInRange(
      guard.dataset.rateLimitFailureResetMinutes,
      DEFAULT_FAILURE_RESET_MINUTES,
      1,
      7 * 24 * 60,
    );
    const BASE_LOCK_MS = baseLockSeconds * 1000;
    const MAX_LOCK_MS = Math.max(maxLockSeconds * 1000, BASE_LOCK_MS);
    const FAILURE_RESET_MS = failureResetMinutes * 60 * 1000;
    const baseErrorMessage = (error.textContent || '').trim() || '密码错误，请重试';
    let lockTimer = 0;

    // Parse URL query string for password parameter
    const getUrlPassword = () => {
      try {
        const params = new URLSearchParams(window.location.search);
        return params.get('p') || params.get('password') || '';
      } catch {
        return '';
      }
    };

    // Clear password from URL to prevent leakage in browser history
    const clearUrlPassword = () => {
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('p');
        url.searchParams.delete('password');
        window.history.replaceState({}, '', url.toString());
      } catch {}
    };

    // Check if already unlocked
    const isUnlocked = () => {
      try {
        return store?.getLocal(STORAGE_KEY) === expectedPassword;
      } catch {
        return false;
      }
    };

    const verifyPassword = (value) => {
      if (value === expectedPassword) return true;

      // Backward compatibility: old plaintext configs.
      return encryptPassword(value) === expectedPassword;
    };

    const getRateState = () => {
      try {
        const raw = store?.getLocal(RATE_LIMIT_KEY);
        if (!raw) return createDefaultRateState();
        return sanitizeRateState(raw);
      } catch {
        return createDefaultRateState();
      }
    };

    const setRateState = (state) => {
      try {
        store?.setLocal(RATE_LIMIT_KEY, state);
      } catch {}
    };

    const clearRateState = () => {
      try {
        store?.removeLocal(RATE_LIMIT_KEY);
      } catch {}
    };

    const clearLockTimer = () => {
      if (!lockTimer) return;
      window.clearTimeout(lockTimer);
      lockTimer = 0;
    };

    const updateErrorMessage = (message, visible = true) => {
      error.textContent = message;
      if (visible) {
        error.classList.add('show');
      } else {
        error.classList.remove('show');
      }
    };

    const setLocked = (locked) => {
      input.disabled = locked;
      btn.disabled = locked;
    };

    const applyLockState = (lockedUntil) => {
      const remain = lockedUntil - Date.now();
      if (remain <= 0) {
        clearLockTimer();
        setLocked(false);
        updateErrorMessage(baseErrorMessage, false);
        const state = getRateState();
        if (state.lockedUntil > 0) {
          setRateState({ ...state, lockedUntil: 0 });
        }
        return false;
      }

      setLocked(true);
      const seconds = Math.max(1, Math.ceil(remain / 1000));
      updateErrorMessage(LOCK_ERROR_TEMPLATE.replace('{seconds}', String(seconds)));
      clearLockTimer();
      lockTimer = window.setTimeout(() => {
        applyLockState(lockedUntil);
      }, 250);
      return true;
    };

    const recordFailedAttempt = () => {
      const now = Date.now();
      const state = normalizeRateState(getRateState(), FAILURE_RESET_MS, now);
      const failures = state.failures + 1;
      const lockMs = computeLockMs(failures, {
        rateLimitEnabled,
        freeAttempts,
        baseLockMs: BASE_LOCK_MS,
        maxLockMs: MAX_LOCK_MS,
      });
      const nextState = {
        failures,
        lockedUntil: lockMs > 0 ? now + lockMs : 0,
        lastFailureAt: now,
      };
      setRateState(nextState);
      return nextState;
    };

    const unlock = () => {
      clearLockTimer();
      clearRateState();
      guard.classList.remove('show');
      document.body.style.overflow = '';
      // Scroll to top when page is unlocked
      window.scrollTo({ top: 0, behavior: 'smooth' });
      // Dispatch event so other components (like music) know we are in.
      // Toast is handled centrally by AppScript to avoid duplicates.
      window.dispatchEvent(new CustomEvent(APP_EVENTS.pageUnlocked, {
        detail: { message: successMessage },
      }));

      // Remove from DOM after transition
      setTimeout(() => {
        guard.remove();
      }, 600);
    };

    if (isUnlocked()) {
      // Already unlocked, don't show guard
      guard.remove();
      return;
    }

    // Check if password is provided via URL query string
    const urlPassword = getUrlPassword();
    if (urlPassword) {
      // Check rate limit even for URL passwords to prevent bypass
      if (rateLimitEnabled) {
        const currentRateState = normalizeRateState(getRateState(), FAILURE_RESET_MS);
        if (currentRateState.lockedUntil > Date.now()) {
          // Currently locked, proceed to show guard
        } else if (verifyPassword(urlPassword)) {
          // Password correct - unlock and clean URL
          try {
            store?.setLocal(STORAGE_KEY, expectedPassword);
          } catch {}
          clearUrlPassword();
          unlock();
          return;
        } else {
          // Password incorrect - record failed attempt
          recordFailedAttempt();
        }
      } else {
        // Rate limiting disabled
        if (verifyPassword(urlPassword)) {
          try {
            store?.setLocal(STORAGE_KEY, expectedPassword);
          } catch {}
          clearUrlPassword();
          unlock();
          return;
        }
      }
    }

    // Prepare to show
    document.body.style.overflow = 'hidden';

    if (!rateLimitEnabled) {
      clearRateState();
      setLocked(false);
    } else {
      const initialRateState = normalizeRateState(getRateState(), FAILURE_RESET_MS);
      setRateState(initialRateState);
      if (initialRateState.lockedUntil > Date.now()) {
        applyLockState(initialRateState.lockedUntil);
      } else {
        setLocked(false);
      }
    }
    
    // We delay showing until loader is ready or immediately
    window.addEventListener('load', () => {
      setTimeout(() => {
        guard.classList.add('show');
        input.focus();
      }, 1000); // Appear slightly before loader finishes (1800ms)
    });

    const handleVerify = () => {
      if (rateLimitEnabled) {
        const activeRateState = normalizeRateState(getRateState(), FAILURE_RESET_MS);
        if (activeRateState.lockedUntil > Date.now()) {
          setRateState(activeRateState);
          applyLockState(activeRateState.lockedUntil);
          return;
        }
      }

      const val = input.value;
      if (verifyPassword(val)) {
        try {
          store?.setLocal(STORAGE_KEY, expectedPassword);
        } catch {}
        unlock();
      } else {
        if (rateLimitEnabled) {
          const state = recordFailedAttempt();
          if (state.lockedUntil > Date.now()) {
            applyLockState(state.lockedUntil);
          } else {
            updateErrorMessage(baseErrorMessage);
          }
        } else {
          updateErrorMessage(baseErrorMessage);
        }
        card.classList.add('shake');
        setTimeout(() => {
          card.classList.remove('shake');
        }, 300);
        input.value = '';
        if (!input.disabled) input.focus();
      }
    };

    btn.addEventListener('click', handleVerify);
    input.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') handleVerify();
    });
  })();
</script>
