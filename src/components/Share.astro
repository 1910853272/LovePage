---
import { resolveAnniversaries, resolveMotto, type Config } from '../config';
import { APP_EVENTS } from '../constants/client';
import { DEFAULT_MESSAGES, type LocaleMessages } from '../i18n/utils';

interface Props {
  config: Config;
  messages?: LocaleMessages;
}

const { config, messages } = Astro.props;
const m = messages ?? DEFAULT_MESSAGES;
const motto = resolveMotto(config);
const anniversaries = resolveAnniversaries(config);
const sharePayload = {
  locale: config.siteLocale || 'zh-CN',
  boy: config.boy,
  girl: config.girl,
  loveDate: config.loveDate,
  marriageDate: config.marriageDate,
  anniversaries,
  countdownThreshold: config.anniversaryCountdownThreshold ?? 10,
  motto,
  anniversaryI18n: m.anniversary,
  generateMemorialCardEvent: APP_EVENTS.generateMemorialCard,
  uiMessages: {
    mottoFallback: m.share.mottoFallback,
    daysUnit: m.share.daysUnit,
    countdownCaption: m.share.countdownCaption,
    todayCaption: m.share.todayCaption,
    todayHero: m.share.todayHero,
    togetherCaption: m.share.togetherCaption,
    loveLabel: m.share.loveLabel,
    marriageLabel: m.share.marriageLabel,
    durationValue: m.share.durationValue,
    startedFrom: m.anniversary.startedFrom,
    footerText: config.demoMode ? config.demoNotice : m.share.footerText,
    previewTitle: m.share.title,
    previewSubtitle: m.share.previewSubtitle,
    closeLabel: m.share.close,
    downloadLabel: m.share.download,
    closePreview: m.share.closePreview,
  },
};
---

<script id="share-script-payload" type="application/json" set:html={JSON.stringify(sharePayload)}></script>
<script>
  import { diffFrom, readJsonPayload } from '../utils';
  import { APP_EVENTS } from '../constants/client';
  import { resolveMemorialCardContext } from '../scripts/share/memorialCard.ts';

  // 与页面正文一致的系统中文字体栈
  const CARD_FONT = getComputedStyle(document.body).fontFamily || 'sans-serif';

  const payload = readJsonPayload('share-script-payload', {
    locale: 'zh-CN',
    boy: '',
    girl: '',
    loveDate: '',
    marriageDate: '',
    anniversaries: [],
    countdownThreshold: 10,
    motto: '',
    anniversaryI18n: null,
    generateMemorialCardEvent: APP_EVENTS.generateMemorialCard,
    uiMessages: {} as Record<string, string>,
  });

  const memorialCardPalette = {
    dark: {
      bgTop: '#1d1132',
      bgBottom: '#0c0a1c',
      blobA: 'rgba(255, 107, 157, 0.30)',
      blobB: 'rgba(255, 190, 110, 0.16)',
      star: '255, 255, 255',
      frame: 'rgba(255, 255, 255, 0.14)',
      eyebrow: 'rgba(255, 255, 255, 0.55)',
      names: '#ffffff',
      motto: 'rgba(255, 226, 238, 0.86)',
      caption: 'rgba(255, 255, 255, 0.8)',
      heroFrom: '#ff8fb1',
      heroTo: '#ffd27a',
      unit: 'rgba(255, 214, 231, 0.92)',
      meta: 'rgba(255, 255, 255, 0.5)',
      divider: 'rgba(255, 255, 255, 0.16)',
      heart: '#ff6b9d',
      statLabel: 'rgba(255, 255, 255, 0.55)',
      statValue: '#ffffff',
      footer: 'rgba(255, 255, 255, 0.38)',
    },
    light: {
      bgTop: '#fff8fb',
      bgBottom: '#ffecf3',
      blobA: 'rgba(255, 107, 157, 0.20)',
      blobB: 'rgba(255, 186, 110, 0.20)',
      star: '214, 51, 108',
      frame: 'rgba(163, 49, 93, 0.16)',
      eyebrow: '#8a6b78',
      names: '#3a2230',
      motto: '#7a4f65',
      caption: '#5c4250',
      heroFrom: '#e0457b',
      heroTo: '#e8873a',
      unit: '#a3315d',
      meta: '#8a6b78',
      divider: 'rgba(163, 49, 93, 0.18)',
      heart: '#e0457b',
      statLabel: '#8a6b78',
      statValue: '#3a2230',
      footer: '#a08894',
    },
  };

  function drawWrappedText(ctx, text, x, y, maxWidth, lineHeight, maxLines) {
    const chars = [...text];
    let line = '';
    let currentY = y;
    let drawn = 0;

    for (let i = 0; i < chars.length; i++) {
      const next = line + chars[i];
      if (ctx.measureText(next).width > maxWidth && line) {
        drawn += 1;
        if (drawn >= maxLines) {
          const trimmed = line.slice(0, Math.max(0, line.length - 1)) + '…';
          ctx.fillText(trimmed, x, currentY);
          return currentY;
        }
        ctx.fillText(line, x, currentY);
        line = chars[i];
        currentY += lineHeight;
      } else {
        line = next;
      }
    }

    if (line) {
      ctx.fillText(line, x, currentY);
    }
    return currentY;
  }

  function formatCardDate(locale, now) {
    try {
      return new Intl.DateTimeFormat(locale, {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(now);
    } catch {
      return `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;
    }
  }

  // 按日期生成固定的星点位置，同一天导出的卡片保持一致
  function seededRandom(seed) {
    let value = seed % 233280;
    return () => {
      value = (value * 9301 + 49297) % 233280;
      return value / 233280;
    };
  }

  // 文字过宽时逐步缩小字号，返回最终字号
  function fitFont(ctx, text, prefix, size, family, maxWidth, minSize = 20) {
    let current = size;
    ctx.font = `${prefix}${current}px ${family}`;
    while (current > minSize && ctx.measureText(text).width > maxWidth) {
      current -= 2;
      ctx.font = `${prefix}${current}px ${family}`;
    }
    return current;
  }

  function drawHeart(ctx, cx, cy, size, color) {
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(cx, cy + size * 0.4);
    ctx.bezierCurveTo(cx - size, cy - size * 0.2, cx - size * 0.4, cy - size * 0.9, cx, cy - size * 0.35);
    ctx.bezierCurveTo(cx + size * 0.4, cy - size * 0.9, cx + size, cy - size * 0.2, cx, cy + size * 0.4);
    ctx.fill();
  }

  function fillTemplate(template, values) {
    return Object.entries(values).reduce((text, [key, value]) => text.replaceAll(`{${key}}`, String(value)), template);
  }

  function daysSince(dateStr, now) {
    const [y, mo, d] = String(dateStr).split('-').map(Number);
    const start = new Date(y || now.getFullYear(), (mo || 1) - 1, d || 1);
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    return Math.max(0, Math.floor((today.getTime() - start.getTime()) / 864e5));
  }

  (function initShare() {
    const floatingShareBtn = document.getElementById('shareBtn');
    let closeActivePreview = null;

    function generateMemorialCard(selectedIndex, cb) {
      // 3:4 竖版，适合朋友圈、小红书和聊天窗口
      const W = 1080;
      const H = 1440;
      const cvs = document.createElement('canvas');
      cvs.width = W;
      cvs.height = H;
      const ctx = cvs.getContext('2d');
      if (!ctx) return;
      const theme = document.documentElement.dataset.theme;
      const palette = theme === 'light' ? memorialCardPalette.light : memorialCardPalette.dark;
      const ui = payload.uiMessages;
      const handFont = String(payload.locale).startsWith('zh') ? "'Ma Shan Zheng', cursive" : "'Dancing Script', cursive";

      const context = resolveMemorialCardContext({
        anniversaries: payload.anniversaries,
        selectedIndex,
        countdownThreshold: payload.countdownThreshold,
        anniversaryI18n: payload.anniversaryI18n || undefined,
      });
      const now = new Date();
      const displayDate = formatCardDate(payload.locale, now);
      const fileDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

      // 背景：竖向渐变 + 两团柔光 + 星点
      const bg = ctx.createLinearGradient(0, 0, 0, H);
      bg.addColorStop(0, palette.bgTop);
      bg.addColorStop(1, palette.bgBottom);
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, W, H);

      for (const [x, y, r, color] of [
        [W * 0.12, H * 0.1, 560, palette.blobA],
        [W * 0.92, H * 0.88, 600, palette.blobB],
      ]) {
        const glow = ctx.createRadialGradient(x, y, 0, x, y, r);
        glow.addColorStop(0, color);
        glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, W, H);
      }

      const random = seededRandom(Number(fileDate.replaceAll('-', '')));
      for (let i = 0; i < 70; i++) {
        ctx.fillStyle = `rgba(${palette.star}, ${(0.15 + random() * 0.45).toFixed(2)})`;
        ctx.beginPath();
        ctx.arc(random() * W, random() * H, 0.8 + random() * 1.8, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.strokeStyle = palette.frame;
      ctx.lineWidth = 2;
      ctx.beginPath();
      if (typeof ctx.roundRect === 'function') {
        ctx.roundRect(48, 48, W - 96, H - 96, 40);
      } else {
        ctx.rect(48, 48, W - 96, H - 96);
      }
      ctx.stroke();

      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      if ('letterSpacing' in ctx) ctx.letterSpacing = '6px';
      ctx.fillStyle = palette.eyebrow;
      ctx.font = `26px ${CARD_FONT}`;
      ctx.fillText(displayDate, W / 2, 150);
      if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';

      const names = `${payload.boy} ♥ ${payload.girl}`;
      ctx.fillStyle = palette.names;
      fitFont(ctx, names, 'bold ', 84, "'Dancing Script', cursive", W - 220, 48);
      ctx.fillText(names, W / 2, 270);

      ctx.fillStyle = palette.motto;
      ctx.font = `40px ${handFont}`;
      drawWrappedText(ctx, payload.motto || ui.mottoFallback, W / 2, 345, W - 260, 56, 2);

      // 主视觉：倒计时天数 / 今天 / 在一起的天数
      let icon = '💕';
      let caption = ui.togetherCaption;
      let heroText = daysSince(payload.loveDate, now).toLocaleString(payload.locale);
      let showUnit = true;
      let metaText = ui.startedFrom.replace('{date}', payload.loveDate);

      if (context) {
        icon = typeof context.anniversary.icon === 'string' && context.anniversary.icon ? context.anniversary.icon : icon;
        metaText = ui.startedFrom.replace('{date}', context.anniversary.date);
        if (context.gap === 0) {
          caption = fillTemplate(ui.todayCaption, { displayLabel: context.displayLabel });
          heroText = ui.todayHero;
          showUnit = false;
        } else {
          caption = fillTemplate(ui.countdownCaption, { displayLabel: context.displayLabel });
          heroText = String(context.gap);
        }
      }

      ctx.font = `64px ${CARD_FONT}`;
      ctx.fillText(icon, W / 2, 540);

      ctx.fillStyle = palette.caption;
      fitFont(ctx, caption, '500 ', 40, CARD_FONT, W - 200, 26);
      ctx.fillText(caption, W / 2, 620);

      const heroSize = showUnit ? 240 : 150;
      const heroFont = `bold ${heroSize}px ${CARD_FONT}`;
      ctx.font = heroFont;
      const heroWidth = Math.min(ctx.measureText(heroText).width, W - 280);
      ctx.font = `500 52px ${CARD_FONT}`;
      const unitWidth = showUnit ? ctx.measureText(ui.daysUnit).width + 18 : 0;
      const heroX = W / 2 - (heroWidth + unitWidth) / 2;
      const heroY = showUnit ? 850 : 810;

      const heroFill = ctx.createLinearGradient(heroX, heroY - heroSize, heroX + heroWidth, heroY);
      heroFill.addColorStop(0, palette.heroFrom);
      heroFill.addColorStop(1, palette.heroTo);
      ctx.textAlign = 'left';
      ctx.fillStyle = heroFill;
      fitFont(ctx, heroText, 'bold ', heroSize, CARD_FONT, W - 280, 80);
      ctx.fillText(heroText, heroX, heroY);
      if (showUnit) {
        ctx.fillStyle = palette.unit;
        ctx.font = `500 52px ${CARD_FONT}`;
        ctx.fillText(ui.daysUnit, heroX + heroWidth + 18, heroY);
      }
      ctx.textAlign = 'center';

      ctx.fillStyle = palette.meta;
      ctx.font = `26px ${CARD_FONT}`;
      ctx.fillText(metaText, W / 2, 930);

      // 分隔线 + 爱心
      ctx.strokeStyle = palette.divider;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(W / 2 - 260, 1020);
      ctx.lineTo(W / 2 - 44, 1020);
      ctx.moveTo(W / 2 + 44, 1020);
      ctx.lineTo(W / 2 + 260, 1020);
      ctx.stroke();
      drawHeart(ctx, W / 2, 1022, 18, palette.heart);

      // 底部数据：相恋 / 婚姻时长
      const stats = [
        { label: ui.loveLabel, date: payload.loveDate },
        { label: ui.marriageLabel, date: payload.marriageDate },
      ].filter((item) => item.date);
      const columnXs = stats.length > 1 ? [W * 0.3, W * 0.7] : [W / 2];
      stats.forEach((item, index) => {
        const diff = diffFrom(item.date);
        const x = columnXs[index];
        ctx.fillStyle = palette.statLabel;
        ctx.font = `26px ${CARD_FONT}`;
        ctx.fillText(item.label, x, 1110);
        ctx.fillStyle = palette.statValue;
        const value = fillTemplate(ui.durationValue, { years: diff.years, days: diff.days });
        fitFont(ctx, value, 'bold ', 46, CARD_FONT, W * 0.36, 28);
        ctx.fillText(value, x, 1176);
      });
      if (stats.length > 1) {
        ctx.strokeStyle = palette.divider;
        ctx.beginPath();
        ctx.moveTo(W / 2, 1080);
        ctx.lineTo(W / 2, 1190);
        ctx.stroke();
      }

      ctx.fillStyle = palette.footer;
      ctx.font = `24px ${CARD_FONT}`;
      if ('letterSpacing' in ctx) ctx.letterSpacing = '2px';
      ctx.fillText(ui.footerText, W / 2, H - 100);
      if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';

      cvs.toBlob((blob) => cb(blob, fileDate), 'image/png');
    }

    function doDownload(blob, dateStr) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `memorial-card-${dateStr}.png`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function openPreviewDialog(blob, dateStr, triggerEl) {
      if (typeof closeActivePreview === 'function') {
        closeActivePreview(true);
      }

      const imageUrl = URL.createObjectURL(blob);
      const overlay = document.createElement('div');
      overlay.className = 'share-preview-overlay';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', payload.uiMessages.previewTitle);
      overlay.innerHTML =
        `<div class="share-preview-card glass">` +
        `<div class="share-preview-header">` +
        `<div class="share-preview-heading">` +
        `<h3 class="share-preview-title">${payload.uiMessages.previewTitle}</h3>` +
        `<p class="share-preview-subtitle">${payload.uiMessages.previewSubtitle}</p>` +
        `</div>` +
        `<button class="share-preview-close" type="button" aria-label="${payload.uiMessages.closePreview}">` +
        `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">` +
        `<path d="M18 6 6 18" />` +
        `<path d="m6 6 12 12" />` +
        `</svg>` +
        `</button>` +
        `</div>` +
        `<div class="share-preview-image-wrap">` +
        `<img src="${imageUrl}" alt="${payload.uiMessages.previewTitle}" />` +
        `</div>` +
        `<div class="share-preview-actions">` +
        `<button class="share-preview-btn share-preview-btn-ghost" type="button">${payload.uiMessages.closeLabel}</button>` +
        `<button class="share-preview-btn share-preview-btn-primary" type="button">${payload.uiMessages.downloadLabel}</button>` +
        `</div>` +
        `</div>`;

      const closeBtn = overlay.querySelector('.share-preview-close');
      const cancelBtn = overlay.querySelector('.share-preview-btn-ghost');
      const downloadBtn = overlay.querySelector('.share-preview-btn-primary');

      const onKeyDown = (evt) => {
        if (evt.key === 'Escape') {
          evt.preventDefault();
          closeOverlay();
        }
      };

      const restoreFocus = triggerEl instanceof HTMLElement ? triggerEl : null;

      const cleanup = () => {
        document.removeEventListener('keydown', onKeyDown);
        document.body.classList.remove('share-preview-open');
        closeActivePreview = null;
      };

      const closeOverlay = (immediate = false) => {
        if (overlay.dataset.closed === '1') return;
        overlay.dataset.closed = '1';
        cleanup();

        const finalize = () => {
          overlay.remove();
          URL.revokeObjectURL(imageUrl);
          if (restoreFocus) restoreFocus.focus();
        };

        if (immediate) {
          finalize();
          return;
        }

        overlay.classList.remove('show');
        setTimeout(finalize, 260);
      };

      if (closeBtn instanceof HTMLButtonElement) {
        closeBtn.addEventListener('click', () => closeOverlay());
      }
      if (cancelBtn instanceof HTMLButtonElement) {
        cancelBtn.addEventListener('click', () => closeOverlay());
      }
      if (downloadBtn instanceof HTMLButtonElement) {
        downloadBtn.addEventListener('click', () => doDownload(blob, dateStr));
      }

      overlay.addEventListener('click', (evt) => {
        if (evt.target === overlay) closeOverlay();
      });

      document.body.appendChild(overlay);
      document.body.classList.add('share-preview-open');
      document.addEventListener('keydown', onKeyDown);
      closeActivePreview = closeOverlay;

      requestAnimationFrame(() => {
        overlay.classList.add('show');
        if (downloadBtn instanceof HTMLButtonElement) {
          downloadBtn.focus();
        }
      });
    }

    function showPreview(selectedIndex, triggerEl = null) {
      const draw = () => {
        generateMemorialCard(selectedIndex, (blob, dateStr) => {
          if (!blob) return;
          openPreviewDialog(blob, dateStr, triggerEl);
        });
      };

      document.fonts ? document.fonts.ready.then(draw) : draw();
    }

    if (floatingShareBtn instanceof HTMLButtonElement) {
      floatingShareBtn.addEventListener('click', (evt) => {
        showPreview(null, evt.currentTarget);
      });
    }

    window.addEventListener(payload.generateMemorialCardEvent, (event) => {
      const detail = event instanceof CustomEvent ? event.detail : null;
      const selectedIndex = Number.isFinite(Number(detail?.anniversaryIndex))
        ? Number(detail.anniversaryIndex)
        : null;
      showPreview(selectedIndex, document.activeElement);
    });
  })();
</script>
